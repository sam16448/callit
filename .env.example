# Copy this file to .env and fill in real values. Never commit .env.

# Supabase: Project Settings > API Keys. Use the publishable (or anon) key only.
# NEVER put the service_role / secret key here: EXPO_PUBLIC_ values are built into the app.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# RevenueCat public SDK key (Test Store key during development)
EXPO_PUBLIC_REVENUECAT_API_KEY=
